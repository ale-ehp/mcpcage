{
  "name": "mcpcage",
  "version": "0.7.0",
  "description": "Puts your AI assistant's plugins (MCP servers) in a locked box. They can't read your files or passwords or reach the internet unless you allow it, and a plugin that changes behind your back is blocked. One command, for Claude, Cursor, VS Code and Copilot.",
  "license": "Apache-2.0",
  "author": "Alessandro Veneziano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ale-ehp/mcpcage.git"
  },
  "bugs": {
    "url": "https://github.com/ale-ehp/mcpcage/issues"
  },
  "homepage": "https://github.com/ale-ehp/mcpcage#readme",
  "type": "module",
  "bin": {
    "mcpcage": "dist/cli.js"
  },
  "files": [
    "dist",
    "runtime"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings",
    "test": "npm run build && vitest run --exclude 'test/**/*.docker.test.ts'",
    "test:coverage": "npm run build && vitest run --exclude 'test/**/*.docker.test.ts' --coverage",
    "test:docker": "npm run build && vitest run test/*.docker.test.ts",
    "compat": "npm run build && node test/compat/run.mjs",
    "mutation": "npm run build && stryker run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sandbox",
    "docker",
    "security",
    "ai-agents",
    "supply-chain"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "^11.0.1",
      "typed-rest-client": {
        "qs": "^6.16.1"
      }
    }
  }
}
